
#LOCAL DATABASE URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/physioversecore"
SECRET_KEY="your-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting (Redis)
REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_STORAGE_BACKEND="memory"

# SMTP Email (for OTP verification)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_NAME="Sahayatri Physio"
SMTP_FROM_EMAIL="noreply@sahayatri.np"
SMTP_USE_TLS=true

# OTP Settings
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Google OAuth (for Google Sign-In)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Public URL of the Next.js frontend. Gateway callbacks (Khalti return_url)
# are built from this. Must be publicly reachable in production.
APP_PUBLIC_URL="http://localhost:3000"

# --- Payment Gateway: eSewa (ePay v2) ---
# Sandbox (UAT) credentials are public and safe to use for development.
# Production product code + secret key come from the eSewa merchant panel (https://merchant.esewa.com.np).
ESEWA_ENV="uat"                                  # uat | prod (switches form/status endpoints)
ESEWA_PRODUCT_CODE="EPAYTEST"                    # your merchant product code (prod)
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"               # sandbox SecretKey; prod key from eSewa
# Browser redirect targets after payment (must be public HTTPS URLs in prod).
# These point at the pvc-web webhook route handlers, which start the server-side verification.
ESEWA_SUCCESS_URL="http://localhost:3000/api/webhooks/payments/esewa"
ESEWA_FAILURE_URL="http://localhost:3000/api/webhooks/payments/esewa"

# --- Payment Gateway: Khalti / IME (KPG-2 Web Checkout) ---
# Khalti and IME Pay are merged into one (Khalti by IME) — one integration accepts both.
# Sandbox secret key: sign up at https://test-admin.khalti.com (login OTP: 987654),
# then copy your "live_secret_key" from the dashboard there.
# Live key comes from https://admin.khalti.com.
KHALTI_ENV="test"                                # test | live (switches dev.khalti.com / khalti.com)
KHALTI_SECRET_KEY=""                             # e.g. "live_secret_key_..." — obtain from test-admin.khalti.com
KHALTI_PUBLIC_KEY=""                             # optional; only needed if the JS/SDK checkout is used
# Browser redirect target after payment (must be public HTTPS URL in prod).
KHALTI_RETURN_URL="http://localhost:3000/api/webhooks/payments/khalti"

# --- Payment Gateway: ConnectIPS (NCHL) — Phase 2 ---
# Requires NCHL merchant registration via your bank (no public/self-serve sandbox).
# NCHL will provide MERCHANTID, APPID, APPNAME, app password, and a CREDITOR.pfx certificate.
CONNECTIPS_ENV="uat"                             # uat | prod (uat.connectips.com / connectips.com)
CONNECTIPS_MERCHANT_ID=""
CONNECTIPS_APP_ID=""
CONNECTIPS_APP_NAME=""
CONNECTIPS_APP_PASSWORD=""
CONNECTIPS_PFX_PATH=""                           # path to CREDITOR.pfx (NEVER commit the .pfx file)
CONNECTIPS_PFX_PASSWORD=""

#cors_origins
CORS_ORIGINS='["*"]'
BACKEND_PORT=9292
