generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = -1
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  THERAPIST
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULE_REQUESTED
  DECLINE_REQUESTED
}

enum SessionType {
  HOME_VISIT
  CLINIC
}

enum ProductCategory {
  EQUIPMENT
  MEDICINE
  NUTRITION
}

enum CartItemType {
  BUY
  RENT
  MEDICINE
  NUTRITION
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String
  role          Role       @default(PATIENT)
  city          String?
  phone         String?
  condition     String?
  specialty     String?
  status        UserStatus @default(PENDING)
  referralCode  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  therapist   Therapist?
  patientProfile PatientProfile?
  sessionsAsPatient Session[] @relation("PatientSessions")
  reviews     Review[] @relation("PatientReviews")
  reports     Report[]
  cartItems   CartItem[]
  payments    Payment[]
  refunds     Refund[]     @relation("PatientRefunds")

  @@index([role])
  @@index([status])
  @@index([city])
  @@index([referralCode])
  @@index([role, status])
}

model PatientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  city        String
  address     String?
  history     String?
  gender      String   @default("Any")
  notifEmail  Boolean  @default(true)
  notifSms    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Therapist {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  specialty  String
  city       String
  gender     String
  rating     Float    @default(0)
  reviews    Int      @default(0)
  price      Float
  experience Int
  bio        String
  mediaUrls  String?

  sessionsOverride       Int?
  reviewsOverride        Int?
  trendOverride          Float?
  linkedComplaintsOverride Int?
  statusOverride         String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions Session[]
  reviewedBy Review[]
  createdReports Report[]
  availabilitySlots AvailabilitySlot[]
  recurringPatterns RecurringPattern[]
  availabilityBlocks AvailabilityBlock[]
  auditLogEntries  AuditLogEntry[]
  blockRequests ScheduleBlockRequest[]
  serviceAreas TherapistServiceArea[]
  verifications Verification[]

  @@index([city])
  @@index([specialty])
  @@index([city, specialty])
}

model Verification {
  id           String   @id @default(cuid())
  therapistId  String
  therapist    Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  documentType String
  uploaded     DateTime @default(now())
  expires      DateTime?
  status       String   @default("Pending review")
  severity     String?
  reportedBy   String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([therapistId])
  @@index([status])
  @@index([therapistId, status])
}

model Product {
  id         String           @id @default(cuid())
  name       String
  category   ProductCategory
  price      Float
  rentPerDay Float            @default(0)
  inStock    Int              @default(0)
  emoji      String           @default("")
  description String?
  imageUrl   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  cartItems CartItem[]
}

model Session {
  id          String        @id @default(cuid())
  therapistId String
  therapist   Therapist     @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User          @relation("PatientSessions", fields: [patientId], references: [id], onDelete: Cascade)
  date        DateTime
  time        String
  type        SessionType   @default(HOME_VISIT)
  status      SessionStatus @default(SCHEDULED)
  address     String
  fee         Float
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  review Review?

  @@index([patientId])
  @@index([therapistId])
  @@index([status])
  @@index([date])
  @@index([patientId, status])
  @@index([therapistId, status])
  @@index([therapistId, date])
}

model Review {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User     @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId])
  @@index([therapistId])
  @@index([patientId, therapistId])
}

model Report {
  id          String    @id @default(cuid())
  patientId   String
  patient     User      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapistId String?
  therapist   Therapist? @relation(fields: [therapistId], references: [id], onDelete: SetNull)
  sessionId   String?
  title       String
  content     String
  fileUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([patientId])
  @@index([therapistId])
  @@index([sessionId])
}

model Payment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  status         String   @default("PENDING")
  method         String   @default("CASH")
  sessionId      String?
  currency       String   @default("NPR")
  platformFee    Float    @default(0)
  paymentType    String?
  transactionRef String?
  cardLast4      String?
  walletMobile   String?
  billingCountry String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([userId, status])
}

model CartItem {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       CartItemType
  quantity   Int          @default(1)
  rentalDays Int          @default(7)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
}

model Setting {
  key       String   @id
  jsonValue String
  updatedAt DateTime @updatedAt
}

model AvailabilitySlot {
  id          String   @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  date        String
  time        String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([therapistId, date, time])
}

model RecurringPattern {
  id          String   @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  days        Json
  sessions    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AvailabilityBlock {
  id          String   @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  dateFrom    String
  dateTo      String
  daysOfWeek  Json
  partsOfDay  Json
  reason      String
  notify      Boolean  @default(true)
  createdAt   DateTime @default(now())

  auditEntry AuditLogEntry[]
}

model AuditLogEntry {
  id        String   @id @default(cuid())
  therapistId String
  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  date      String
  time      String?
  reason    String
  scope     String
  source    String
  blockId   String?
  block     AvailabilityBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([therapistId])
  @@index([date])
}

model ScheduleBlockRequest {
  id          String   @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  dateFrom    String
  dateTo      String
  daysOfWeek  Json
  partsOfDay  Json
  reason      String
  notify      Boolean  @default(true)
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([therapistId])
  @@index([status])
  @@index([therapistId, status])
}

enum CaseSource {
  PATIENT_SUBMITTED
  THERAPIST_SUBMITTED
  ADMIN_MANUAL
}

model Complaint {
  id              String   @id @default(cuid())
  type            String
  complainantId   String
  complainantName String
  againstId       String
  againstName     String
  category        String
  priority        String   @default("Normal")
  status          String   @default("Open")
  description     String
  bookingId       String?
  evidenceUrls    String?
  preferredOutcome String?
  assignee        String?
  adminNotes      String?
  source          CaseSource @default(PATIENT_SUBMITTED)
  refundId        String?    @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refund Refund?

  @@index([complainantId])
  @@index([againstId])
  @@index([status])
  @@index([type])
  @@index([type, status])
}

model ServiceArea {
  id        String   @id @default(cuid())
  name      String
  localities Json
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  therapistServiceAreas TherapistServiceArea[]

  @@index([name])
  @@index([status])
}

enum RefundReason {
  NO_SHOW
  DOUBLE_CHARGE
  SERVICE_QUALITY
  CANCELLATION
}

enum RefundStatus {
  PENDING
  APPROVED
  DENIED
}

model Refund {
  id          String       @id @default(cuid())
  patientId   String
  patient     User         @relation("PatientRefunds", fields: [patientId], references: [id], onDelete: Cascade)
  bookingId   String
  amount      Float
  reason      RefundReason
  status      RefundStatus @default(PENDING)
  denyReason  String?
  resolvedAt  DateTime?
  assigneeId  String?
  source      CaseSource   @default(PATIENT_SUBMITTED)
  complaintId String?      @unique
  complaint   Complaint?   @relation(fields: [complaintId], references: [id])
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([patientId])
  @@index([status])
  @@index([bookingId])
  @@index([assigneeId])
  @@index([patientId, status])
}

model TherapistServiceArea {
  id            String      @id @default(cuid())
  therapistId   String
  therapist     Therapist   @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  serviceAreaId String
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([therapistId, serviceAreaId])
  @@index([therapistId])
  @@index([serviceAreaId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum ServiceCategory {
  CLINICAL
  SHOP
}

model Service {
  id          String          @id @default(cuid())
  name        String
  description String
  category    ServiceCategory
  iconName    String          @default("")
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([isActive])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  purpose   String   @default("signup")
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}
