generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = -1
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  THERAPIST
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULE_REQUESTED
  DECLINE_REQUESTED
}

enum SessionType {
  HOME_VISIT
  CLINIC
}

enum ProductCategory {
  EQUIPMENT
  MEDICINE
  NUTRITION
}

enum CartItemType {
  BUY
  RENT
  MEDICINE
  NUTRITION
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String
  role          Role       @default(PATIENT)
  city          String?
  phone         String?
  specialty     String?
  status        UserStatus @default(PENDING)
  referralCode  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  therapist   Therapist?
  sessionsAsPatient Session[] @relation("PatientSessions")
  reviews     Review[] @relation("PatientReviews")
  reports     Report[]
  cartItems   CartItem[]
  payments    Payment[]
}

model Therapist {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  specialty  String
  city       String
  gender     String
  rating     Float    @default(0)
  reviews    Int      @default(0)
  price      Float
  experience Int
  bio        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions Session[]
  reviewedBy Review[]
  createdReports Report[]
  availabilitySlots AvailabilitySlot[]
  recurringPatterns RecurringPattern[]
  availabilityBlocks AvailabilityBlock[]
  auditLogEntries  AuditLogEntry[]
  blockRequests ScheduleBlockRequest[]
}

model Product {
  id         String           @id @default(cuid())
  name       String
  category   ProductCategory
  price      Float
  rentPerDay Float            @default(0)
  inStock    Int              @default(0)
  emoji      String           @default("")
  description String?
  imageUrl   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  cartItems CartItem[]
}

model Session {
  id          String        @id @default(cuid())
  therapistId String
  therapist   Therapist     @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User          @relation("PatientSessions", fields: [patientId], references: [id], onDelete: Cascade)
  date        DateTime
  time        String
  type        SessionType   @default(HOME_VISIT)
  status      SessionStatus @default(SCHEDULED)
  address     String
  fee         Float
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  review Review?
}

model Review {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patientId   String
  patient     User     @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id          String    @id @default(cuid())
  patientId   String
  patient     User      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapistId String?
  therapist   Therapist? @relation(fields: [therapistId], references: [id], onDelete: SetNull)
  sessionId   String?
  title       String
  content     String
  fileUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  status    String   @default("PENDING")
  method    String   @default("CASH")
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       CartItemType
  quantity   Int          @default(1)
  rentalDays Int          @default(7)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Setting {
  key       String   @id
  jsonValue String
  updatedAt DateTime @updatedAt
}

model AvailabilitySlot {
  id          String   @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  date        String
  time        String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([therapistId, date, time])
}

model RecurringPattern {
  id          String   @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  days        Json
  sessions    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AvailabilityBlock {
  id          String   @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  dateFrom    String
  dateTo      String
  daysOfWeek  Json
  partsOfDay  Json
  reason      String
  notify      Boolean  @default(true)
  createdAt   DateTime @default(now())

  auditEntry AuditLogEntry[]
}

model AuditLogEntry {
  id        String   @id @default(cuid())
  therapistId String
  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  date      String
  time      String?
  reason    String
  scope     String
  source    String
  blockId   String?
  block     AvailabilityBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model ScheduleBlockRequest {
  id          String   @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  dateFrom    String
  dateTo      String
  daysOfWeek  Json
  partsOfDay  Json
  reason      String
  notify      Boolean  @default(true)
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
